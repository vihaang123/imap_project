# Copy to .env and fill in. Never commit .env.
NASA_API_KEY=DEMO_KEY
REDIS_URL=redis://127.0.0.1:6379/1
APOD_CACHE_TTL=300
# Optional: fake NASA responses (0.8s simulated latency) for practising offline.
# Keep this at 0 when recording the benchmark numbers you submit.
USE_MOCK_NASA=0
MOCK_NASA_LATENCY=0.8
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
